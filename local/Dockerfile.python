# One image for every local Python service. Build context = repo root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

COPY libs /src/libs
COPY services /src/services
COPY local/gateway /src/local/gateway
COPY db /app/db
RUN pip install \
      /src/libs/common /src/libs/capture_client /app/db \
      /src/services/ingest /src/services/extract /src/services/outbox_relay /src/services/cache_updater \
      /src/services/indexer /src/services/reorder_checker /src/services/core_api \
      /src/services/review_dispatcher /src/services/eval_nightly /src/services/ops \
      /src/local/gateway \
      uvicorn[standard] \
 && rm -rf /src

ENV OPS_MIGRATIONS_DIR=/app/db
RUN useradd --system --uid 10001 app
USER app
