# Local defaults (docs/CONTRACTS.md §1). Copy to .env to run services on the host against `make infra`.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory
DB_POOL_MAX=5
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER=false
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_AUTH=none
TOPIC_CAPTURES_RAW=captures.raw
TOPIC_INVENTORY_EVENTS=inventory.events
RABBITMQ_URL=amqp://inventory:inventory@localhost:5672/%2F
RABBITMQ_QUEUE_TYPE=quorum
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_AUTH=none
S3_BUCKET=captures
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
EXTRACTOR=stub
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
PROMPT_VERSION=v1
CONFIDENCE_THRESHOLD=0.85
AUDIT_SAMPLE_RATE=0.05
AUTH_MODE=dev
OUTBOX_BATCH_SIZE=500
OUTBOX_POLL_INTERVAL_MS=50
