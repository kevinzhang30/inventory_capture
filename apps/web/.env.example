# Server-side base URL of the API (local gateway or API Gateway invoke URL).
API_BASE_URL=http://localhost:8080
# dev: no login, identity switcher sends x-dev-* headers. cognito: Hosted UI login via next-auth.
AUTH_MODE=dev
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
